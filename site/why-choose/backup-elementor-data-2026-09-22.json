[{"id":"88faa1d","elType":"container","settings":[],"elements":[{"id":"26163fa","elType":"widget","settings":{"_margin":{"bottom":"0","isLinked":false,"left":"0","right":"0","top":"150","unit":"px"},"_margin_mobile":{"bottom":"0","isLinked":false,"left":"0","right":"0","top":"150","unit":"px"},"align":"center","align_mobile":"center","eael_vto_writing_gradient_color_repeater":[{"_id":"7365c17","eael_vto_writing_gradient_color":"#7C62FF","eael_vto_writing_gradient_color_location":{"size":50,"unit":"%"}},{"_id":"a24fb4b","eael_vto_writing_gradient_color":"#FF6464","eael_vto_writing_gradient_color_location":{"size":90,"unit":"%"}}],"title":"Why Choose Ascend STEM Academy","title_color":"#037CAF"},"elements":[],"widgetType":"heading"}],"isInner":false},{"id":"a14bbe0","elType":"container","settings":[],"elements":[{"id":"a70d333","elType":"widget","settings":{"_margin":{"bottom":"0","isLinked":false,"left":"0","right":"0","top":"25","unit":"px"},"align":"center","align_mobile":"center","eael_vto_writing_gradient_color_repeater":[{"_id":"7f1664c","eael_vto_writing_gradient_color":"#7C62FF","eael_vto_writing_gradient_color_location":{"size":50,"unit":"%"}},{"_id":"3d2d87f","eael_vto_writing_gradient_color":"#FF6464","eael_vto_writing_gradient_color_location":{"size":90,"unit":"%"}}],"editor":"<p><b>Why Is There a Cost to Enroll?<\/b><\/p><p><span style=\"font-weight: 400\">Families sometimes ask why pay Ascend STEM Academy when they could navigate homeschooling on their own or choose another umbrella school. It's a fair question and the answer comes down to what you're actually getting.<\/span><\/p>","text_color":"#000000","typography_font_family":"Roboto","typography_font_weight":"400","typography_typography":"custom"},"elements":[],"widgetType":"text-editor"},{"id":"dc36c8a","elType":"container","settings":{"content_width":"full"},"elements":[{"id":"5082ff9","elType":"widget","settings":{"_margin":{"bottom":"0","isLinked":false,"left":"0","right":"0","top":"25","unit":"px"},"align":"center","align_mobile":"center","eael_vto_writing_gradient_color_repeater":[{"_id":"904b114","eael_vto_writing_gradient_color":"#7C62FF","eael_vto_writing_gradient_color_location":{"size":50,"unit":"%"}},{"_id":"92cdc43","eael_vto_writing_gradient_color":"#FF6464","eael_vto_writing_gradient_color_location":{"size":90,"unit":"%"}}],"editor":"<p><b>You're getting a partner.<\/b><\/p><p><span style=\"font-weight: 400\">Other umbrella schools give you a name to put on your documents and little else. Ascend STEM Academy is different because every family gets individualized compliance support from someone who actually reviews your records, not a portal that auto-generates a form.<\/span><\/p>","text_color":"#000000"},"elements":[],"widgetType":"text-editor"},{"id":"04c2282","elType":"widget","settings":{"_margin":{"bottom":"10","isLinked":false,"left":"0","right":"0","top":"30","unit":"px"},"eael_vto_writing_gradient_color_repeater":[{"_id":"ee8e1ef","eael_vto_writing_gradient_color":"#7C62FF","eael_vto_writing_gradient_color_location":{"size":50,"unit":"%"}},{"_id":"b813e21","eael_vto_writing_gradient_color":"#FF6464","eael_vto_writing_gradient_color_location":{"size":90,"unit":"%"}}],"title":"What that looks like in practice:","title_color":"#037CAF","typography_font_family":"Roboto","typography_font_size_mobile":{"size":25,"sizes":[],"unit":"px"},"typography_font_weight":"600","typography_typography":"custom"},"elements":[],"widgetType":"heading"},{"id":"60a19b0","elType":"widget","settings":{"eael_vto_writing_gradient_color_repeater":[{"_id":"fb9a680","eael_vto_writing_gradient_color":"#7C62FF","eael_vto_writing_gradient_color_location":{"size":50,"unit":"%"}},{"_id":"248f716","eael_vto_writing_gradient_color":"#FF6464","eael_vto_writing_gradient_color_location":{"size":90,"unit":"%"}}],"editor":"<ul><li><b>Individual oversight of your child's file<\/b><span style=\"font-weight: 400\"> — Someone with real oversight experience is reviewing what you submit, not a shared inbox.<\/span><\/li><li style=\"font-weight: 400\"><b>Same-day or next-day responses<\/b><span style=\"font-weight: 400\"> — When you have a compliance question, you get a real answer quickly, not a support ticket queue.<\/span><\/li><li style=\"font-weight: 400\"><b>A diploma built to keep your child competitive<\/b><span style=\"font-weight: 400\"> — Our diplomas are structured to mirror Florida's state academic standards, so transcripts look familiar and credible to colleges, employers, and scholarship committees rather than like an informal homeschool record.<\/span><\/li><li style=\"font-weight: 400\"><b>School-of-record credibility<\/b><span style=\"font-weight: 400\"> — Complete, standards-aligned records maintained from day one, so if your child ever needs official verification (for college, military enlistment, a job, or a licensing board) it's already there and already credible.<\/span><\/li><li style=\"font-weight: 400\"><b>A resource hub included with enrollment<\/b><span style=\"font-weight: 400\"> — Enrolled families get access to 60+ curated resources covering curriculum planning, subject-specific teaching support, testing prep, and more at no extra cost.<\/span><\/li><li style=\"font-weight: 400\"><b>Guidance through gray areas<\/b><span style=\"font-weight: 400\"> — Standardized testing requirements, evaluation options, record-keeping rules. We walk you through the parts of Florida homeschool law that trip families up.<\/span><\/li><\/ul><p><b>A real relationship, not a form submission<\/b><span style=\"font-weight: 400\"> — You'll know who to call. That person will know your child's name.<\/span><\/p>","text_color":"#000000"},"elements":[],"widgetType":"text-editor"}],"isInner":true}],"isInner":false},{"id":"e8726cf7","elType":"container","settings":{"flex_direction":"column"},"elements":[{"id":"6d37c72e","elType":"widget","settings":{"_margin":{"bottom":"10","isLinked":false,"left":"0","right":"0","top":"30","unit":"px"},"align":"ce