# Copy to .env and adjust as needed:  cp .env.example .env
# .env is git-ignored. These credentials are LOCAL ONLY — never put
# production database or API credentials in this file.

# Host port for the local site -> http://localhost:8080
WP_PORT=8080
# Host port for Adminer (database browser) -> http://localhost:8081
ADMINER_PORT=8081
# Host port for Mailpit (catches outbound mail) -> http://localhost:8025
MAILPIT_PORT=8025

# Local database credentials
DB_NAME=ascend_local
DB_USER=ascend
DB_PASSWORD=ascend
DB_ROOT_PASSWORD=root

# Local WordPress admin account created by `make install`
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin
WP_ADMIN_EMAIL=dev@ascendstemacademy.test
WP_SITE_TITLE=Ascend STEM Academy (Local)
