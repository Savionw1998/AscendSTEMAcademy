# Local environment
.env
.env.local

# Database dumps (contain student and family data — never commit)
db/
*.sql
*.sql.gz

# ---------------------------------------------------------------------------
# Only FIRST-PARTY code is tracked. WordPress core, the Astra parent theme and
# third-party plugins are installed into the Docker volume by scripts/, so they
# are deliberately absent here.
# ---------------------------------------------------------------------------

wp-config.php
wp-content/uploads/
wp-content/upgrade/
wp-content/cache/
wp-content/languages/

# Themes: ignore everything except our child theme.
wp-content/themes/*
!wp-content/themes/astra-child/

# Plugins: ignore everything except the plugins we author.
wp-content/plugins/*
!wp-content/plugins/ascend-*/
!wp-content/plugins/README.md

# Logs
*.log
debug.log
wp-content/debug.log

# Dependencies
node_modules/
vendor/

# Editors and OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
